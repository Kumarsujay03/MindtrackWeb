{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/keepalive", "schedule": "* * * * *" }
  ],
  "redirects": [
    { "source": "/favicon.ico", "destination": "/logo.png", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api|_next|.*\\..*).*)", "destination": "/" }
  ]
}
